rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Get user ID
    function getUserId() {
      return request.auth.uid;
    }

    // ============================================================================
    // USERS COLLECTION - Allow queries and document access
    // ============================================================================

    match /users/{userId} {
      // Any authenticated user can read (needed for role checks)
      allow read: if isAuthenticated();

      // Users can update own data (except role), admins can update any
      allow update: if isAuthenticated();

      // Only admins can create/delete
      allow create, delete: if isAuthenticated();
    }

    // ============================================================================
    // USER PREFERENCES
    // ============================================================================

    match /userPreferences/{userId} {
      allow read, write: if isAuthenticated();
    }

    // ============================================================================
    // YEAR-SCOPED COLLECTIONS (permissive for now)
    // ============================================================================

    // Allow public read/write for API routes on year-scoped collections
    match /{year}/{document=**} {
      // Allow public read and write for API consumption
      allow read, write: if year.matches('^20[2-9][0-9]$');
    }

    // ============================================================================
    // ROOT LEVEL COLLECTIONS
    // ============================================================================

    match /userTasks/{taskId} {
      // Allow read/write for authenticated users and public write for API routes
      allow read, write: if true;
    }

    match /taskControl/{controlId} {
      allow read, write: if isAuthenticated();
    }

    match /whatsapp_verified_numbers/{phoneNumber} {
      // Allow public read/write for API routes
      allow read, write: if true;
    }

    // ============================================================================
    // STUDENT DOCUMENTS (old array structure - deprecated)
    // ============================================================================

    match /{year}/lista_de_estudantes {
      // Allow public read/write for API routes
      allow read, write: if year.matches('^20[2-9][0-9]$');
    }

    // ============================================================================
    // NEW STUDENT COLLECTION STRUCTURE (Phase 1 migration)
    // ============================================================================

    match /students/{studentId} {
      // Allow public read/write for migration and API routes
      allow read, write: if true;

      // Allow subcollections (contacts, etc)
      match /{document=**} {
        allow read, write: if true;
      }
    }
  }
}