# ====================================
# FREQUÊNCIA ANUAL - Variáveis de Ambiente
# ====================================

# ------------------
# Firebase Auth (Atual)
# ------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abc123

# Firebase Admin SDK (Server-side)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ------------------
# Auth Provider
# ------------------
# Qual provedor de autenticação usar (firebase ou supabase)
# Padrão: firebase
AUTH_PROVIDER=firebase

# ------------------
# Supabase (Banco de Dados)
# ------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ------------------
# Evolution API (WhatsApp)
# ------------------
# URL base da Evolution API (local ou remoto)
EVOLUTION_API_BASE_URL=http://localhost:8080

# API Key para autenticação
EVOLUTION_API_KEY=your-evolution-api-key

# Nome da instância WhatsApp
EVOLUTION_INSTANCE_NAME=frequencia-anual

# ------------------
# Logging
# ------------------
# Nível de log (debug|info|warn|error)
NEXT_PUBLIC_LOG_LEVEL=error

# Habilitar logs no console (true|false)
NEXT_PUBLIC_ENABLE_CONSOLE_LOGS=false
