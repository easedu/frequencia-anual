rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Get user ID
    function getUserId() {
      return request.auth.uid;
    }

    // ============================================================================
    // USERS COLLECTION - Allow queries and document access
    // ============================================================================

    match /users/{userId} {
      // Any authenticated user can read (needed for role checks)
      allow read: if isAuthenticated();

      // Users can update own data (except role), admins can update any
      allow update: if isAuthenticated();

      // Only admins can create/delete
      allow create, delete: if isAuthenticated();
    }

    // ============================================================================
    // USER PREFERENCES
    // ============================================================================

    match /userPreferences/{userId} {
      allow read, write: if isAuthenticated();
    }

    // ============================================================================
    // YEAR-SCOPED COLLECTIONS (permissive for now)
    // ============================================================================

    // Allow public read access for API routes (write still requires auth)
    match /{year}/{document=**} {
      // Allow public read for API consumption
      allow read: if year.matches('^20[2-9][0-9]$');
      // Write requires authentication
      allow write: if isAuthenticated() && year.matches('^20[2-9][0-9]$');
    }

    // ============================================================================
    // ROOT LEVEL COLLECTIONS
    // ============================================================================

    match /userTasks/{taskId} {
      allow read, write: if isAuthenticated();
    }

    match /taskControl/{controlId} {
      allow read, write: if isAuthenticated();
    }

    match /whatsapp_verified_numbers/{phoneNumber} {
      // Allow public read for API routes
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // ============================================================================
    // STUDENT DOCUMENTS (old array structure - deprecated)
    // ============================================================================

    match /{year}/lista_de_estudantes {
      // Allow public read for API routes
      allow read: if year.matches('^20[2-9][0-9]$');
      allow write: if isAuthenticated() &&
                     year.matches('^20[2-9][0-9]$');
    }
  }
}